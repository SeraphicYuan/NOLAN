{
  "plugins": [
    "import"
  ],
  "rules": {
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/Math\\.random/]",
        "message": "non-deterministic Math.random() \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/Date\\.now/]",
        "message": "time-based Date.now() \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/new\\ Date\\(/]",
        "message": "time-based new Date() \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/performance\\.now/]",
        "message": "time-based performance.now() \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/yoyo:/]",
        "message": "a yoyo (repeating) tween \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/yoyo\\ :/]",
        "message": "a yoyo (repeating) tween \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/repeat:\\-1/]",
        "message": "an infinite repeat \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/repeat:\\ \\-1/]",
        "message": "an infinite repeat \u2014 the frame is ONE paused, seeked timeline (author.py rejects this)."
      },
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex colour \u2014 use a NOLAN theme token via var(). NOLAN ships 41 themes; a literal follows none of them."
      },
      {
        "selector": "Literal[value=/(filter|backdrop-filter|box-shadow)\\s*:/]",
        "message": "transform_opacity_only \u2014 animate transform and opacity only."
      },
      {
        "selector": "Literal[value=/\\b(top|left|width|height)\\s*:\\s*[-0-9]/]",
        "message": "transform_opacity_only \u2014 layout properties re-flow per frame; use transform."
      }
    ]
  },
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-glow",
      "--accent-ink",
      "--accent-soft",
      "--density",
      "--dur-base",
      "--dur-cinematic",
      "--dur-slow",
      "--font-body",
      "--font-display-cn",
      "--font-display-en",
      "--font-features",
      "--font-mono",
      "--hero-num-font",
      "--hero-num-style",
      "--hero-num-track",
      "--hero-num-weight",
      "--r-card",
      "--r-stage",
      "--rule",
      "--rule-style",
      "--rule-w",
      "--shell",
      "--surface",
      "--surface-2",
      "--surface-3",
      "--text",
      "--text-2",
      "--text-faint",
      "--text-mute",
      "--type-scale"
    ],
    "tokenKinds": {
      "--accent": "color",
      "--accent-glow": "color",
      "--accent-ink": "color",
      "--accent-soft": "color",
      "--density": "spacing",
      "--dur-base": "spacing",
      "--dur-cinematic": "spacing",
      "--dur-slow": "spacing",
      "--font-body": "font",
      "--font-display-cn": "font",
      "--font-display-en": "font",
      "--font-features": "font",
      "--font-mono": "font",
      "--hero-num-font": "spacing",
      "--hero-num-style": "spacing",
      "--hero-num-track": "spacing",
      "--hero-num-weight": "spacing",
      "--r-card": "radius",
      "--r-stage": "radius",
      "--rule": "color",
      "--rule-style": "color",
      "--rule-w": "color",
      "--shell": "color",
      "--surface": "color",
      "--surface-2": "color",
      "--surface-3": "color",
      "--text": "color",
      "--text-2": "color",
      "--text-faint": "color",
      "--text-mute": "color",
      "--type-scale": "spacing"
    },
    "fontFamilies": [],
    "x-nolan": {
      "source": "generated by explore/2026-08-04-infographic/ds_seed.py",
      "enforced_by_gate": [
        "Math.random",
        "Date.now",
        "new Date(",
        "performance.now",
        "yoyo:",
        "yoyo :",
        "repeat:-1",
        "repeat: -1"
      ],
      "declared_but_unenforced": [
        "transform_opacity_only",
        "caption_keep_out_83pct",
        "sid_prefixed_ids",
        "no_exit_on_non_final",
        "duration_preserving"
      ]
    }
  }
}