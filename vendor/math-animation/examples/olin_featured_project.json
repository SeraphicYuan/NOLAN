    "script_policy": "locked",
    "target_duration_seconds": 62.0
  },
  "math_ledger": {
    "claims": [
      {
        "id": "claim.exact-projection",
        "statement": "Orthographic projection of the exact lift along the y axis recovers the planar shadow for every sampled point and tested time.",
        "verification": "verified",
        "assumptions": [
          "Projection is orthographic along the y axis.",
          "The same u and v coordinates are used by the shadow and lift."
        ],
        "evidence": [
          "The generated scene performs numerical allclose checks at four time values before rendering."
        ]
      },
      {
        "id": "claim.cylindrical-interpretation",
        "statement": "The cylindrical state reinterprets q and c as radius and angle; it is not claimed to preserve the planar shadow.",
        "verification": "verified",
        "assumptions": [],
        "evidence": [
          "Its first two coordinates are (40+q)cos(c) and (40+q)sin(c)."
        ]
      }
    ],
    "formulas": [
      {
        "id": "formula.shadow",
        "latex_parts": [
          "S(i,t)",
          "=",
          "0.017\\bigl(q+40\\cos c,\\ 0,\\ q\\sin c+35d-200\\bigr)"
        ],
        "plain_language": "The original construction is drawn as a flat xz shadow.",
        "symbol_roles": {
          "0": "fixed",
          "q,c,d": "changing"
        },
        "assumptions": []
      },
      {
        "id": "formula.exact-lift-featured",
        "latex_parts": [
          "E(i,t)",
          "=",
          "0.017\\bigl(q+40\\cos c,\\ 40\\sin c,\\ q\\sin c+35d-200\\bigr)"
        ],
        "plain_language": "The exact lift adds a y coordinate while retaining x and z.",
        "symbol_roles": {
          "x,z": "fixed",
          "y": "changing"
        },
        "assumptions": []
      },
      {
        "id": "formula.projection",
        "latex_parts": [
          "\\pi_{xz}\\!\\left(E(i,t)\\right)",
          "=",
          "S(i,t)"
        ],
        "plain_language": "Dropping the lift's y coordinate exactly recovers the shadow.",
        "symbol_roles": {
          "E": "changing",
          "S": "fixed"
        },
        "assumptions": [
          "Projection is along the y axis."
        ]
      },
      {
        "id": "formula.cylindrical",
        "latex_parts": [
          "C(i,t)",
          "=",
          "0.017\\bigl((40+q)\\cos c,\\ (40+q)\\sin c,\\ 35d-200\\bigr)"
        ],
        "plain_language": "The cylindrical view treats c as an angle and 40+q as a radius.",
        "symbol_roles": {
          "c": "changing",
          "40+q": "primary"
        },
        "assumptions": []
      }
    ]
