{
  "schema_version": "math-animation.project.v1",
  "project_id": "determinant-area-stress",
  "title": "Why the determinant measures area",
  "request": {
    "source_kind": "script",
    "content": "Begin with a unit square. This matrix stretches one direction and shears the other. The square becomes a parallelogram with three times the area, exactly the absolute determinant.\n\nA reflection flips the orientation of an asymmetric shape. Its determinant is negative one. The sign records the flip, while the absolute value preserves the area.\n\nA singular matrix sends both basis directions onto the same line. The square collapses, its area becomes zero, and so does the determinant. Absolute determinant is the universal area scale.",
    "audience": "introductory linear algebra learners",
    "script_policy": "locked",
    "target_duration_seconds": 22.97150000000001
  },
  "math_ledger": {
    "claims": [
      {
        "id": "claim.area-scale",
        "statement": "For a two-dimensional linear map, absolute determinant is the multiplicative area scale.",
        "verification": "verified",
        "assumptions": [
          "The map is linear and acts on planar area."
        ],
        "evidence": [
          "Direct determinant calculations in all three beats."
        ]
      },
      {
        "id": "claim.orientation",
        "statement": "A negative determinant reverses orientation while its absolute value remains the area scale.",
        "verification": "verified",
        "assumptions": [],
        "evidence": [
          "Reflection matrix B has determinant negative one."
        ]
      }
    ],
    "formulas": [
      {
        "id": "matrix.A",
        "latex_parts": [
          "A=\\begin{bmatrix}2&1\\\\0&\\frac{3}{2}\\end{bmatrix}"
        ],
        "plain_language": "A shear and stretch with determinant three.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "det.A",
        "latex_parts": [
          "|\\det A|=|3|=3"
        ],
        "plain_language": "The transformation triples area.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "matrix.B",
        "latex_parts": [
          "B=\\begin{bmatrix}-1&0\\\\0&1\\end{bmatrix}"
        ],
        "plain_language": "A reflection across the vertical axis.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "det.B",
        "latex_parts": [
          "\\det B=-1"
        ],
        "plain_language": "The negative sign records orientation reversal.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "matrix.C",
        "latex_parts": [
          "C=\\begin{bmatrix}1&1\\\\1&1\\end{bmatrix}"
        ],
        "plain_language": "Both basis directions map to the same line.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "det.C",
        "latex_parts": [
          "\\det C=0"
        ],
        "plain_language": "A singular map collapses planar area.",
        "symbol_roles": {},
        "assumptions": []
      },
      {
        "id": "det.general",
        "latex_parts": [
          "\\text{area scale}=|\\det M|"
        ],
        "plain_language": "Absolute determinant is the planar area scale.",
        "symbol_roles": {},
        "assumptions": []
      }
    ]
  },
